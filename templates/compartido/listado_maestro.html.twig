{% extends 'base.html.twig' %}

{% block body %}
<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">{% block titulo_seccion %}Listado Maatriz{% endblock %}</h1>
            <p class="text-muted mb-0">{% block subtitulo_seccion %}Gestiona y explora los registros de esta sección.{% endblock %}</p>
        </div>
        <div>
            {% block botones_cabecera %}{% endblock %}
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded">
        <div class="card-body p-0">
            {% block contenido_tabla %}
                <div class="p-4 text-center text-muted">
                    <i class="fa-solid fa-folder-open fa-2x mb-2"></i>
                    <p class="mb-0">No hay datos disponibles en este bloque.</p>
                </div>
            {% endblock %}
        </div>
    </div>
</div>
{% endblock %}