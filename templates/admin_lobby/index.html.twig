{% extends 'base.html.twig' %}

{% block title %}Panel del Master - Partida de Rol{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="card shadow-sm border border-2 bg-light p-4 mb-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fs-1 text-success">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                </div>
                <div>
                    <h1 class="display-6 fw-black text-uppercase text-dark mb-0" style="letter-spacing: 0.5px;">Panel del Director de Juego</h1>
                    <span class="text-muted small text-uppercase font-monospace" style="font-size: 0.7rem; letter-spacing: 1px;">
                        Escritor del códice: <span class="text-success fw-bold">{{ app.user.userIdentifier }}</span>
                    </span>
                </div>
            </div>
            <div>
                <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-secondary text-uppercase fw-bold font-monospace">
                    <i class="fa-solid fa-right-from-bracket me-1"></i> Cerrar Sesión
                </a>
            </div>
        </div>
    </div>

    <div class="row g-4">
        
        <div class="col-12 col-lg-7">
            <h5 class="text-uppercase fw-bold text-secondary font-monospace mb-3 d-flex align-items-center gap-2" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                <i class="fa-solid fa-gears text-success"></i> Control del Códice y Base de Datos
            </h5>

            <div class="card shadow-sm border border-2 bg-white p-4 mb-4">
                <div class="d-flex align-items-start gap-3 mb-3">
                    <div class="p-3 rounded bg-success-subtle text-success border border-success-subtle fs-4">
                        <i class="fa-solid fa-book-atlas"></i>
                    </div>
                    <div>
                        <h4 class="h5 fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.3px;">El Códice Mágico</h4>
                        <p class="text-muted small mb-0" style="line-height: 1.5;">
                            Tienes acceso al códice mágico de Eldrick, donde se recogen todos los datos que los aventureros han ido descubriendo... ¡TEN CUIDADO! Tienes una gran responsabilidad al ser el encargado de escribir en sus páginas. Recuerda que puedes ojear desde aquí toda la información al igual que el resto de jugadores.
                        </p>
                    </div>
                </div>
                
                <div class="border-top pt-3 d-flex justify-content-end">
                    <a href="{{ path('sonata_admin_dashboard') }}" class="btn btn-success text-uppercase fw-bold font-monospace px-4 py-2" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                        <i class="fa-solid fa-scroll me-2"></i> Escribir en el códiex (Gestionar Datos)
                    </a>
                </div>
            </div>

            <div class="card border border-2 bg-white p-4 shadow-sm" style="border-left: 4px solid var(--bs-success-border-subtle) !important;">
                <div class="d-flex align-items-start gap-3">
                    <div class="fs-3 text-secondary">
                        <i class="fa-solid fa-circle-info"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark text-uppercase mb-1" style="font-size: 0.9rem;">Vista de consulta activa</h5>
                        <p class="text-muted small mb-0" style="line-height: 1.5;">
                            Recuerda que como Director de Juego puedes navegar libremente por los menús del menú superior para validar las descripciones de las Razas, Clases y Sendas mecánicas tal y como las verán tus jugadores en tiempo real.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-5">
            
            <h5 class="text-uppercase fw-bold text-secondary font-monospace mb-3 d-flex align-items-center gap-2" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                <i class="fa-solid fa-shield-halved text-muted"></i> Privilegios de Seguridad
            </h5>
            
            <div class="card shadow-sm border border-2 bg-light p-4">
                <p class="text-muted small mb-3" style="line-height: 1.5;">
                    Estás visualizando la interfaz de control técnico. Tu cuenta posee permisos de administración global sobre las entidades Doctrine de la campaña.
                </p>
                
                <div class="font-monospace small d-flex flex-column gap-2 bg-white p-3 rounded border" style="font-size: 0.75rem;">
                    <div class="d-flex justify-content-between border-bottom pb-1">
                        <span class="text-muted">MASTER:</span>
                        <span class="fw-bold text-dark">{{ app.user.userIdentifier }}</span>
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <span class="text-muted">ROLES DE SEGURIDAD:</span>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            {% for rol in app.user.roles %}
                                <span class="badge bg-success-subtle text-success-emphasis font-monospace" style="font-size: 0.55rem;">
                                    {{ rol }}
                                </span>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .fw-black { font-weight: 900; }
</style>
{% endblock %}