{% extends 'base.html.twig' %}

{% block title %}Panel del Master - Partida de Rol{% endblock %}

{% block body %}
    <div style="max-width: 800px; margin: 0 auto; background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
        <h1 style="color: #2c3e50; border-bottom: 2px solid #e67e22; padding-bottom: 10px;">
            🧙‍♂️ Panel de Control del Master / Admin
        </h1>
        <p>Has iniciado sesión con privilegios elevados. Desde aquí tienes el control narrativo y técnico de la partida.</p>
        
        <div style="background: #fdf2e9; padding: 15px; border-left: 4px solid #e67e22; margin: 20px 0; border-radius: 4px;">
            <strong>Información de Gestión:</strong>
            <ul>
                <li>Master/Admin conectado: <code>{{ app.user.userIdentifier }}</code></li>
                <li>Permisos activos: <code>{{ app.user.roles|join(', ') }}</code></li>
            </ul>
        </div>

        <div style="margin-top: 30px;">
            <h3>Accesos Rápidos de Gestión:</h3>
            <a href="{{ path('sonata_admin_dashboard') }}" style="display: inline-block; background: #2ecc71; color: white; padding: 12px 24px; text-decoration: none; border-radius: 4px; font-weight: bold; margin-right: 10px;">
                Ir al Backend de Sonata (Gestionar BDD)
            </a>
        </div>
        
        <hr style="border: 0; border-top: 1px solid #eee; margin: 30px 0;">
        <a href="{{ path('app_logout') }}" style="display: inline-block; background: #e74c3c; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-weight: bold;">
            Cerrar Sesión
        </a>
    </div>
{% endblock %}