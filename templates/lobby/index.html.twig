{% extends 'base.html.twig' %}

{% block title %}Lobby de Jugadores - Partida de Rol{% endblock %}

{% block body %}
    <div style="max-width: 800px; margin: 0 auto; background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
        <h1 style="color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 10px;">
            ⚔️ Bienvenido al Lobby de Jugadores
        </h1>
        <p>Estás dentro del proyecto de forma segura. Esta vista es exclusiva para los jugadores de la partida.</p>
        
        <div style="background: #e8f4fd; padding: 15px; border-left: 4px solid #3498db; margin: 20px 0; border-radius: 4px;">
            <strong>Tu información de sesión:</strong>
            <ul>
                <li>Usuario: <code>{{ app.user.userIdentifier }}</code></li>
                <li>Rol actual: <code>{{ app.user.roles|join(', ') }}</code></li>
            </ul>
        </div>

        <p>Pronto aquí podrás ver tu ficha de personaje, inventario y los elementos del mundo que hayas descubierto.</p>
        
        <hr style="border: 0; border-top: 1px solid #eee; margin: 30px 0;">
        <a href="{{ path('app_logout') }}" style="display: inline-block; background: #e74c3c; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; font-weight: bold;">
            Cerrar Sesión
        </a>
    </div>
{% endblock %}