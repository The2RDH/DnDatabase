{# templates/lobby/personajes/mi_personaje.html.twig #}
{% extends 'lobby/personajes/detalle.html.twig' %}

{% block title %}Mi Personaje - {{ personaje.nombre }}{% endblock %}

{% block boton_volver %}
    <span class="badge bg-success px-3 py-2 border border-success-subtle rounded-pill">
        <i class="fa-solid fa-user-check"></i> Vista de Propietario
    </span>
{% endblock %}

{% block titulo_ficha %}{% endblock %}
{% block subtitulo_ficha %}{% endblock %}

{% block bloque_principal %}
    <div class="d-flex align-items-center justify-content-between p-3 mb-4 bg-white border rounded shadow-sm">
        <div>
            <span class="badge bg-danger text-uppercase fw-bold mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                Nivel {{ personaje.nivel ?? '1' }}
            </span>
            <h1 class="h2 fw-bold text-dark text-uppercase mb-2" style="letter-spacing: 0.5px;">
                {{ personaje.nombreCompleto ?? personaje.nombre }} {{ personaje.apellido ?? '' }}
            </h1>
            
            <div class="d-flex flex-wrap gap-2 text-muted small font-monospace align-items-center">
                <span><i class="fa-solid fa-dna text-secondary me-1"></i>{{ personaje.raza ? personaje.raza.nombre : 'Desconocida' }}</span>
                <span class="text-black-50">•</span>
                <span><i class="fa-solid fa-shield-halved text-secondary me-1"></i>{{ personaje.clase ? personaje.clase.nombre : 'Sin Clase' }}</span>
                <span class="text-black-50">•</span>
                <span class="text-warning-emphasis fw-bold"><i class="fa-solid fa-wand-magic-sparkles me-1"></i>{{ personaje.especializacion ? personaje.especializacion.nombre : 'Ninguna' }}</span>
            </div>
        </div>

        <div class="flex-shrink-0 ps-3">
            {% if personaje.token is defined and personaje.token is not empty %}
                <img src="{{ asset('media/tokens/' ~ personaje.token) }}" alt="Token {{ personaje.nombre }}" 
                     class="rounded-circle border border-2 border-warning shadow-sm img-zoom-trigger" 
                     style="width: 75px; height: 75px; object-fit: cover;"
                     data-bs-toggle="modal" data-bs-target="#modalImagenPersonaje" data-img-src="{{ asset('media/tokens/' ~ personaje.token) }}">
            {% elseif personaje.clase is not null and personaje.clase.token is not empty %}
                <img src="{{ asset('media/class/' ~ personaje.clase.token) }}" alt="Token de Clase" 
                     class="rounded-circle border border-2 border-warning shadow-sm img-zoom-trigger" 
                     style="width: 75px; height: 75px; object-fit: cover;"
                     data-bs-toggle="modal" data-bs-target="#modalImagenPersonaje" data-img-src="{{ asset('media/class/' ~ personaje.clase.token) }}">
            {% else %}
                <div class="rounded-circle border border-2 border-warning bg-secondary text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 75px; height: 75px; font-size: 1.5rem;">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
            {% endif %}
        </div>
    </div>

    {{ parent() }}
    
    <div class="mt-5 pt-4 border-top">
        <h4 class="mb-3 text-dark fw-bold">
            <i class="fa-solid fa-book-bookmark text-warning"></i> Mis Crónicas y Lore Secreto
        </h4>
        <p class="text-muted small mb-4">
            A continuación se muestran los fragmentos de historia, secretos y conocimientos del mundo que solo tu personaje conoce.
        </p>

        {% if personaje.lores is not empty %}
            <div class="accordion shadow-sm rounded" id="accordionLorePrivado">
                {% for lore in personaje.lores %}
                    <div class="accordion-item border-start-0 border-end-0 border-top-0 mb-2 rounded bg-white">
                        <h2 class="accordion-header" id="headingPrivado{{ lore.id }}">
                            <button class="accordion-button collapsed fw-bold text-dark bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePrivado{{ lore.id }}" aria-expanded="false" aria-controls="collapsePrivado{{ lore.id }}">
                                <i class="fa-solid fa-scroll text-muted me-2 small"></i> {{ lore.titulo }}
                            </button>
                        </h2>
                        <div id="collapsePrivado{{ lore.id }}" class="accordion-collapse collapse" aria-labelledby="headingPrivado{{ lore.id }}" data-bs-parent="#accordionLorePrivado">
                            <div class="accordion-body bg-light text-secondary border-top px-4 py-3" style="line-height: 1.7; font-size: 0.95rem;">
                                {{ lore.texto|nl2br }}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="p-4 bg-light rounded text-center border border-dashed">
                <i class="fa-solid fa-feather d-block fs-3 mb-2 text-muted"></i>
                <p class="text-muted mb-0 italic">Tu personaje aún no tiene ningún fragmento de lore oculto o crónica secreta.</p>
            </div>
        {% endif %}
    </div>

    <div class="modal fade" id="modalImagenPersonaje" tabindex="-1" aria-labelledby="modalImagenPersonajeLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark border border-secondary shadow-lg">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title text-warning small text-uppercase font-monospace" id="modalImagenPersonajeLabel">
                        <i class="fa-solid fa-eye me-1"></i> Vista Ampliada: {{ personaje.nombre }}
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <img id="imagenModalTarget" src="" alt="{{ personaje.nombre }}" class="img-fluid rounded border border-secondary bg-neutral shadow" style="max-height: 80vh; object-fit: contain;">
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalImagenPersonaje = document.getElementById('modalImagenPersonaje');
            var modalImgTarget = document.getElementById('imagenModalTarget');

            modalImagenPersonaje.addEventListener('show.bs.modal', function (event) {
                var triggerElement = event.relatedTarget;
                var imgSrc = triggerElement.getAttribute('data-img-src');
                modalImgTarget.setAttribute('src', imgSrc);
            });
        });
    </script>

    <style>
        .img-zoom-trigger {
            cursor: zoom-in;
            transition: transform 0.25s ease, filter 0.25s ease;
        }
        .img-zoom-trigger:hover {
            transform: scale(1.04);
            filter: brightness(1.05);
            z-index: 5;
        }
    </style>
{% endblock %}

{% block bloque_lateral %}
    {{ parent() }}
    
    <div class="mt-4 bg-light p-3 rounded shadow-sm text-center border">
        <h6 class="fw-bold text-dark text-start mb-3">
            <i class="fa-solid fa-image text-danger small"></i> Imagen de personaje
        </h6>
        
        <div class="position-relative overflow-hidden rounded mb-3 bg-dark d-flex align-items-center justify-content-center border" style="height: 200px;">
            {% if personaje.imagen is defined and personaje.imagen is not empty %}
                <img src="{{ asset('media/images/' ~ personaje.imagen) }}" alt="Retrato de {{ personaje.nombre }}" 
                     class="w-100 h-100 img-zoom-trigger" 
                     style="object-fit: cover; object-position: top center;"
                     data-bs-toggle="modal" data-bs-target="#modalImagenPersonaje" data-img-src="{{ asset('media/images/' ~ personaje.imagen) }}">
            {% else %}
                <div class="text-muted text-center p-3">
                    <i class="fa-solid fa-user-ninja display-4 opacity-25 mb-2 d-block"></i>
                    <small class="d-block font-monospace" style="font-size: 0.65rem;">SIN RETRATO DISPONIBLE</small>
                </div>
            {% endif %}
        </div>
        <span class="text-muted font-monospace d-block text-end" style="font-size: 0.65rem;"><i class="fa-solid fa-magnifying-glass-plus me-1"></i> Haz clic para ampliar</span>
    </div>
    
    <div class="mt-3 pt-3 border-top bg-light p-3 rounded shadow-sm">
        <h6 class="fw-bold text-dark mb-2">
            <i class="fa-solid fa-wallet small text-warning"></i> Recursos del Héroe
        </h6>
        <div class="d-flex align-items-center justify-content-between bg-white border rounded p-2 mt-2">
            <span class="text-muted small font-monospace">Bolsa de Monedas:</span>
            <span class="text-warning-emphasis fw-bold font-monospace d-flex align-items-center gap-1" style="font-size: 0.95rem;">
                <i class="fa-solid fa-coins text-warning"></i> {{ personaje.oro ?? 0 }} <small class="text-muted fw-normal" style="font-size: 0.75rem;">Oro</small>
            </span>
        </div>
    </div>
    
    <div class="mt-3 pt-3 border-top bg-light p-3 rounded shadow-sm">
        <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-id-card small"></i> Cuenta Vinculada</h6>
        <small class="d-block text-muted"><strong>Nick de Comunidad:</strong> {{ personaje.jugador.nick }}</small>
        <small class="d-block text-muted"><strong>Rol/Especialidad:</strong> {{ personaje.jugador.especialidad ?? 'Ninguna' }}</small>
    </div>
{% endblock %}