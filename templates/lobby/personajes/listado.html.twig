{% extends 'compartido/listado_maestro.html.twig' %}

{% block title %}Personajes - Universo RPG{% endblock %}

{% block titulo_seccion %}Héroes y Habitantes{% endblock %}
{% block subtitulo_seccion %}Explora el listado completo de personajes y NPCs registrados en el mundo.{% endblock %}

{% block contenido_tabla %}
<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th class="text-center" style="width: 80px;">ID</th>
                <th>Personaje</th>
                <th>Raza / Clase</th>
                <th class="text-center">Nivel</th>
                <th>Origen</th>
                <th class="text-end px-4" style="width: 150px;">Ficha</th>
            </tr>
        </thead>
        <tbody>
            {% for p in personajes %}
                <tr>
                    <td class="text-center fw-bold text-muted">{{ p.id }}</td>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            {% if p.token is defined and p.token is not empty %}
                                <img src="{{ asset('media/tokens/' ~ p.token) }}" alt="Token {{ p.nombre }}" 
                                    class="rounded-circle border border-warning shadow-sm" 
                                    style="width: 40px; height: 40px; object-fit: cover;">
                            {% elseif p.clase is not null and p.clase.token is not empty %}
                                <img src="{{ asset('media/class/' ~ p.clase.token) }}" alt="Token de Clase" 
                                    class="rounded-circle border border-warning shadow-sm" 
                                    style="width: 40px; height: 40px; object-fit: cover;">
                            {% else %}
                                <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center border border-warning shadow-sm" 
                                    style="width: 40px; height: 40px; font-size: 0.9rem;">
                                    <i class="fa-solid fa-user-shield"></i>
                                </div>
                            {% endif %}

                            <div>
                                <div class="fw-bold text-dark">{{ p.nombreCompleto }}</div>
                                <small class="text-muted">Jugador: {{ p.jugador ? p.jugador.nick : 'Ninguno (NPC)' }}</small>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">{{ p.raza ? p.raza : 'Desconocida' }}</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">{{ p.clase ? p.clase : 'Sin Clase' }}</span>
                    </td>
                    <td class="text-center">
                        <span class="badge bg-dark fw-bold">{{ p.nivel ?? 1 }}</span>
                    </td>
                    <td>
                        <span class="text-muted"><i class="fa-solid fa-location-dot small"></i> {{ p.originario ?? 'Desconocido' }}</span>
                    </td>
                    <td class="text-end px-4">
                        <a href="{{ path('app_lobby_personaje_detalle', {'id': p.id}) }}" class="btn btn-sm btn-outline-primary">
                            <i class="fa-solid fa-eye"></i> Ver Ficha
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="p-5 text-center text-muted">
                        <i class="fa-solid fa-users-slash fa-2x mb-2"></i>
                        <p class="mb-0">No se ha encontrado ningún personaje en los archivos.</p>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}