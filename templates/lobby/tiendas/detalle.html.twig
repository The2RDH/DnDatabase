{% extends 'base.html.twig' %}

{% block title %}Tienda de {{ comerciante.nombre }}{% endblock %}

{% block body %}
<div class="container py-4">
    
    <div class="mb-4">
        <a href="{{ path('app_lobby_tiendas') }}" class="btn btn-sm btn-outline-secondary px-3 fw-bold">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver a Mercaderes y Tiendas
        </a>
    </div>

    <div class="card border-0 shadow-sm bg-white overflow-hidden">
        
        <div class="card-header bg-dark p-4 border-0 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-light p-0.5 border" style="width: 60px; height: 60px;">
                    <img src="{{ comerciante.token ? asset(comerciante.token) : asset('img/default_token.png') }}" 
                         alt="{{ comerciante.nombre }}" 
                         class="rounded-circle w-100 h-100" 
                         style="object-fit: cover;">
                </div>
                <div>
                    <h1 class="h4 fw-bold text-white mb-0">{{ comerciante.nombre }}</h1>
                    <span class="badge bg-warning text-dark fw-bold px-2 py-1 mt-1.5" style="font-size: 0.8rem;">
                        <i class="fa-solid fa-tags me-1"></i> {{ comerciante.tiendaDescripcion ?? 'Suministros Generales' }}
                    </span>
                </div>
            </div>
            
            <div class="d-flex align-items-center gap-2">
                {% if comerciante.lugar %}
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle py-2 px-3">
                        <i class="fa-solid fa-map-pin text-danger me-1"></i> {{ comerciante.lugar }}
                    </span>
                {% endif %}
                <a href="{{ path('app_lobby_npc_detalle', {'id': comerciante.id}) }}" class="btn btn-sm btn-secondary py-2 px-3 fw-bold" title="Ver ficha del NPC">
                    <i class="fa-solid fa-address-card"></i> <span class="d-none d-md-inline ms-1">Ver Perfil</span>
                </a>
            </div>
        </div>

        <div class="card-body p-0">
            {% if comerciante.ofertaComercials is empty %}
                <div class="p-5 text-center text-muted">
                    <i class="fa-solid fa-boxes-empty display-5 mb-3 d-block text-black-50"></i>
                    <p class="mb-0 italic lead">Este mercader no dispone de mercancías en venta en este momento.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-dark">
                        <thead class="table-light text-secondary uppercase fs-7 fw-bold">
                            <tr>
                                <th scope="col" class="ps-4" style="width: 50%;">Artículo</th>
                                <th scope="col" style="width: 25%;">Categoría y Rareza</th>
                                <th scope="col" class="text-center" style="width: 10%;">Stock</th>
                                <th scope="col" class="text-end pe-4" style="width: 15%;">Precio</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for oferta in comerciante.ofertaComercials %}
                                <tr>
                                    <td class="ps-4">
                                        <div>
                                            <strong class="d-block text-dark-emphasis">{{ oferta.objeto ? oferta.objeto.nombre : 'Artículo Desconocido' }}</strong>
                                            {% if oferta.objeto and oferta.objeto.descripcion %}
                                                <small class="text-muted d-block text-truncate" style="max-width: 500px;">{{ oferta.objeto.descripcion }}</small>
                                            {% endif %}
                                        </div>
                                    </td>
                                    
                                    <td>
                                        <span class="text-dark fw-medium small d-block">
                                            <i class="fa-solid fa-wand-magic-sparkles me-1 text-secondary opacity-75"></i>
                                            {{ oferta.objeto and oferta.objeto.tipoObjetos ? oferta.objeto.tipoObjetos.nombre : 'Miscelánea' }}
                                        </span>
                                        {% if oferta.objeto and oferta.objeto.rareza %}
                                            <small class="text-muted d-block mt-0.5" style="font-size: 0.75rem;">
                                                <i class="fa-solid fa-gem me-1 text-info opacity-75"></i> {{ oferta.objeto.rareza.nombre }}
                                            </small>
                                        {% endif %}
                                    </td>
                                    
                                    <td class="text-center">
                                        {% if oferta.cantidad > 0 %}
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2">
                                                {{ oferta.cantidad }} uds
                                            </span>
                                        {% else %}
                                            <span class="badge bg-secondary text-white-50 border px-2">
                                                ∞ (Ilimitado)
                                            </span>
                                        {% endif %}
                                    </td>
                                    
                                    <td class="text-end pe-4">
                                        <span class="fw-bold text-dark fs-5">
                                            {{ oferta.precio|number_format(2, ',', '.') }}
                                        </span>
                                        <i class="fa-solid fa-coins text-warning ms-1" title="Monedas de Oro"></i>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
        
    </div>
</div>
{% endblock %}