{% extends 'base.html.twig' %}

{% block title %}Compendio - Clases y Especializaciones{% block title_append %}{% endblock %}{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="mb-4">
        <a href="{{ path('app_lobby_otrasCaracteristicas') }}" class="btn btn-sm btn-outline-secondary text-uppercase fw-bold">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver al Compendio
        </a>
    </div>

    <div class="card shadow-sm border border-2 bg-dark text-white p-4 mb-5" style="background: linear-gradient(135deg, #1e1e24 0%, #2a2a35 100%);">
        <div class="d-flex flex-column flex-sm-row align-items-center gap-4">
            <div class="text-center text-sm-start flex-grow-1">
                <h1 class="display-5 fw-black text-uppercase text-warning mb-0" style="letter-spacing: 0.5px;">Clases y Especializaciones</h1>
            </div>
        </div>
    </div>

    <div class="row g-4">
        {% if clases is not empty %}
            {% for clase in clases %}
                <div class="col-12">
                    <div class="card shadow-sm border border-2 bg-white">
                        <div class="card-body p-4">
                            <div class="row g-4">
                                
                                <div class="col-12 col-md-5 border-end-md pb-3 pb-md-0">
                                    <div class="d-flex align-items-center gap-3 mb-3">
                                        {% if clase.token is not empty %}
                                            <img src="{{ asset('media/class/' ~ clase.token) }}" 
                                                 alt="Token {{ clase.nombre }}" 
                                                 class="rounded border bg-light shadow-sm flex-shrink-0" 
                                                 style="width: 56px; height: 56px; object-fit: cover;">
                                        {% else %}
                                            <div class="rounded bg-light border text-danger d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" 
                                                 style="width: 56px; height: 56px;">
                                                <i class="fa-solid fa-shield-halved fs-4"></i>
                                            </div>
                                        {% endif %}
                                        
                                        <div>
                                            <h3 class="h4 fw-bold text-uppercase text-dark mb-0" style="letter-spacing: 0.5px;">
                                                {{ clase.nombre }}
                                            </h3>
                                            
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                {% if clase.tipoClase is not null %}
                                                    <span class="badge bg-danger-subtle text-danger-emphasis font-monospace text-uppercase" style="font-size: 0.6rem;">
                                                        {{ clase.tipoClase.nombre ?? clase.tipoClase }}
                                                    </span>
                                                {% endif %}
                                                {% if clase.recurso is not null %}
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis font-monospace text-uppercase" style="font-size: 0.6rem;">
                                                        <i class="fa-solid fa-bolt me-1"></i>{{ clase.recurso.nombre ?? clase.recurso }}
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <p class="text-dark-emphasis small mb-0 bg-light p-3 rounded border" style="line-height: 1.6;">
                                        {{ clase.descripcion ?: 'No hay una descripción adecuada para esta clase por el momento.' }}
                                    </p>
                                </div>
                                
                                <div class="col-12 col-md-7 d-flex flex-column justify-content-start">
                                    <h6 class="text-uppercase fw-bold text-secondary font-monospace mb-3 d-flex align-items-center gap-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                        <i class="fa-solid fa-diagram-project text-danger"></i> Especializaciones Disponibles
                                    </h6>
                                    
                                    <div class="row g-3">
                                        {# En tu entidad se llama 'especializaciones' en plural #}
                                        {% if clase.especializaciones is not empty %}
                                            {% for esp in clase.especializaciones %}
                                                <div class="col-12 col-sm-6">
                                                    <div class="p-3 bg-light rounded border h-100 d-flex flex-column">
                                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                                            <h4 class="h6 fw-bold text-dark text-uppercase mb-0" style="letter-spacing: 0.3px;">
                                                                {{ esp.nombre }}
                                                            </h4>
                                                            
                                                            {# Si la especialización usa un recurso diferente al de la clase madre #}
                                                            {% if esp.recursos is not empty %}
                                                                <div class="d-flex gap-1">
                                                                    {% for rec in esp.recursos %}
                                                                        {# Comprobamos si este recurso es diferente al recurso base de la clase #}
                                                                        {% if rec != clase.recurso %}
                                                                            <span class="badge bg-white text-secondary border font-monospace text-uppercase" 
                                                                                style="font-size: 0.55rem;" 
                                                                                title="Recurso alternativo de especialización: {{ rec.nombre }}">
                                                                                {{ rec.nombre }}
                                                                            </span>
                                                                        {% endif %}
                                                                    {% endfor %}
                                                                </div>
                                                            {% endif %}
                                                        </div>
                                                        <p class="text-muted mb-0 flex-grow-1" style="font-size: 0.75rem; line-height: 1.4;">
                                                            {{ esp.descripcion ?: 'Especialización táctica lista para el despliegue en campaña.' }}
                                                        </p>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        {% else %}
                                            <div class="col-12">
                                                <div class="p-3 text-center text-muted bg-light rounded border border-dashed font-monospace small">
                                                    <i class="fa-solid fa-ban me-1"></i> No se han descubierto especializaciones avanzadas para esta disciplina.
                                                </div>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="col-12">
                <div class="card border border-2 bg-white text-center p-5 shadow-sm">
                    <div class="text-secondary display-4 mb-3 opacity-50">
                        <i class="fa-solid fa-circle-question"></i>
                    </div>
                    <h4 class="fw-bold text-uppercase text-secondary mb-2" style="font-size: 1.1rem;">Registros de Disciplinas Vacíos</h4>
                    <p class="text-muted mx-auto mb-0 small" style="max-width: 480px;">
                        No se ha encontrado ninguna clase de personaje configurada en los registros del compendio.
                    </p>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<style>
    .fw-black { font-weight: 900; }
    
    /* Media query rápida para añadir borde de separación solo en pantallas medianas o grandes */
    @media (min-width: 768px) {
        .border-end-md {
            border-end: none !important;
            border-right: 1px solid var(--bs-border-color-translucent) !important;
        }
    }
</style>
{% endblock %}