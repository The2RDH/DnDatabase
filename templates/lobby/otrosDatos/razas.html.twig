{% extends 'base.html.twig' %}

{% block title %}Compendio - Razas y Linajes{% block title_append %}{% endblock %}{% endblock %}

{% block body %}
<div class="container py-5">

    <!-- BOTÓN VOLVER -->
    <div class="mb-4">
        <a href="{{ path('app_lobby_otrasCaracteristicas') }}" class="btn btn-sm btn-outline-secondary text-uppercase fw-bold">
            <i class="fa-solid fa-arrow-left me-1"></i> Volver al Compendio
        </a>
    </div>

    <!-- CABECERA DE LA CATEGORÍA -->
    <div class="card shadow-sm border border-2 bg-dark text-white p-4 mb-4" style="background: linear-gradient(135deg, #1e1e24 0%, #2a2a35 100%);">
        <div class="d-flex flex-column flex-sm-row align-items-center gap-4">
            <div class="text-center text-sm-start flex-grow-1">
                <h1 class="display-5 fw-black text-uppercase text-warning mb-0" style="letter-spacing: 0.5px;">Razas y Linajes</h1>
            </div>
        </div>
    </div>

    <!-- REJILLA DE RAZAS -->
    <div class="row g-4">
        {% if razas is not empty %}
            {% for raza in razas %}
                <div class="col-12 col-lg-6">
                    <div class="card shadow-sm border border-2 bg-white h-100 d-flex flex-column">
                        <div class="card-body p-4 flex-grow-1">
                            
                            <!-- CABECERA DE LA TARJETA (TOKEN + INFO BÁSICA) -->
                            <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom border-light-emphasis">
                                {% if raza.token is not empty %}
                                    <img src="{{ asset('media/razas/' ~ raza.token) }}" 
                                         alt="Token {{ raza.nombre }}" 
                                         class="rounded border bg-light shadow-sm flex-shrink-0" 
                                         style="width: 56px; height: 56px; object-fit: cover;">
                                {% else %}
                                    <div class="rounded bg-light border text-danger d-flex align-items-center justify-content-center flex-shrink-0 shadow-sm" 
                                         style="width: 56px; height: 56px;">
                                        <i class="fa-solid fa-dna fs-4"></i>
                                    </div>
                                {% endif %}
                                
                                <div>
                                    <h3 class="h4 fw-bold text-uppercase text-dark mb-0" style="letter-spacing: 0.5px;">
                                        {{ raza.nombre }}
                                    </h3>
                                    
                                    <!-- Mostrar el Origen si existe -->
                                    {% if raza.origen is not null %}
                                        <span class="badge bg-secondary-subtle text-secondary-emphasis font-monospace text-uppercase mt-1 shadow-sm-sm" style="font-size: 0.65rem;">
                                            <i class="fa-solid fa-earth-americas me-1"></i> {{ raza.origen.nombre ?? raza.origen }}
                                        </span>
                                    {% else %}
                                        <span class="badge bg-light text-muted font-monospace text-uppercase mt-1 border" style="font-size: 0.65rem;">
                                            Origen Desconocido
                                        </span>
                                    {% endif %}
                                </div>
                            </div>

                            <!-- DESCRIPCIÓN -->
                            <p class="text-dark-emphasis mb-3 bg-light p-3 rounded border small" style="line-height: 1.6; min-height: 70px;">
                                {{ raza.descripcion ?: 'No se dispone de una crónica detallada sobre las costumbres o fisiología de este linaje en los archivos del gremio.' }}
                            </p>

                            <!-- RASGOS RACIALES -->
                            <div>
                                <h6 class="text-uppercase fw-bold text-secondary font-monospace mb-2" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    <i class="fa-solid fa-star me-1 text-warning"></i> Rasgos:
                                </h6>
                                <div class="d-flex flex-wrap gap-2">
                                    {% if raza.rasgos is not empty %}
                                        {% for rasgo in raza.rasgos %}
                                            <span class="badge bg-light text-dark border border-2 px-2 py-1 small rounded font-monospace" 
                                                  title="{{ rasgo.descripcion|default('Sin descripción') }}" 
                                                  style="font-size: 0.75rem; cursor: help;">
                                                {{ rasgo.nombre }}
                                            </span>
                                        {% endfor %}
                                    {% else %}
                                        <span class="text-muted small italic">No se han catalogado propiedades biológicas o culturales específicas.</span>
                                    {% endif %}
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <!-- CASO VACÍO -->
            <div class="col-12">
                <div class="card border border-2 bg-white text-center p-5 shadow-sm">
                    <div class="text-secondary display-4 mb-3 opacity-50">
                        <i class="fa-solid fa-circle-question"></i>
                    </div>
                    <h4 class="fw-bold text-uppercase text-secondary mb-2" style="font-size: 1.1rem;">Registros de Linajes Vacíos</h4>
                    <p class="text-muted mx-auto mb-0 small" style="max-width: 480px;">
                        No se ha encontrado ninguna raza o especie registrada en la base de datos de la campaña actual.
                    </p>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<style>
    .fw-black { font-weight: 900; }
    .italic { font-style: italic; }
</style>
{% endblock %}