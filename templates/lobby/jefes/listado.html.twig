{% extends 'base.html.twig' %}

{% block title %}Jefes y Élites{% block title_append %}{% endblock %}{% endblock %}

{% block body %}
<div class="container py-5">
    
    <div class="row mb-5 text-center">
        <div class="col-12">
            <h1 class="display-4 fw-bold text-uppercase tracking-wider text-dark mb-2" style="letter-spacing: 2px;">
                <i class="fa-solid fa-skull-crossbones text-danger me-2"></i> Objetivos de Élite
            </h1>
            <p class="text-muted fs-5 mx-auto mb-0" style="max-width: 600px;">
                Registro y estado de las mayores amenazas del reino. Recompensas de botín y estado vital actualizado.
            </p>
            <hr class="border-danger opacity-25 my-4 mx-auto" style="width: 100px; height: 3px;">
        </div>
    </div>

    <div class="row g-4 justify-content-center">
        {% for jefe in jefes %}
            <div class="col-12 col-md-11 col-lg-9">
                <div class="card h-100 shadow-sm border border-2 border-light-subtle overflow-hidden transition-all hover-shadow" 
                     style="background: #fdfdfd; transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;">
                    
                    <div class="row g-0 h-100">
                        
                        <div class="col-12 col-sm-4 col-md-3 d-flex align-items-center justify-content-center p-4 text-center position-relative" 
                             style="background: linear-gradient(135deg, #1e1e24 0%, #2a2a35 100%); min-height: 180px;">
                            
                            {# TAG de Desafío flotando sobre el token #}
                            <span class="position-absolute top-0 start-0 m-2 badge bg-danger text-uppercase fw-bold shadow-sm" style="font-size: 0.75rem;">
                                AMENAZA: {{ jefe.nivel }}
                            </span>

                            <a href="{{ path('app_lobby_jefe_detalle', {'id': jefe.id}) }}" class="d-block position-relative hidden-focus">
                                {% if jefe.token %}
                                    <img src="{{ asset(jefe.token) }}" alt="{{ jefe.nombre }}" 
                                         class="img-fluid rounded-circle border border-3 border-warning shadow-sm animate-pulse-subtle" 
                                         style="width: 120px; height: 120px; object-fit: cover;">
                                {% else %}
                                    <div class="rounded-circle bg-secondary border border-3 border-warning d-flex align-items-center justify-content-center text-white shadow-sm" 
                                         style="width: 120px; height: 120px; font-size: 2.5rem;">
                                        <i class="fa-solid fa-crown opacity-50"></i>
                                    </div>
                                {% endif %}
                                
                                {# Sello de "DERROTADO" superpuesto en el token #}
                                {% if jefe.derrotado %}
                                    <div class="position-absolute top-50 start-50 translate-middle bg-danger text-white text-uppercase fw-black px-2 py-1 rounded shadow" 
                                         style="font-size: 0.65rem; letter-spacing: 1px; transform: translate(-50%, -50%) rotate(-15deg) !important; z-index: 2;">
                                        DERROTADO
                                    </div>
                                {% endif %}
                            </a>
                        </div>

                        <div class="col-12 col-sm-8 col-md-9 d-flex flex-column justify-content-between p-3">
                            <div>
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h2 class="h5 fw-bold text-dark mb-0 text-uppercase tracking-wide">
                                        <a href="{{ path('app_lobby_jefe_detalle', {'id': jefe.id}) }}" class="text-decoration-none text-dark hover-danger">
                                            {{ jefe.nombre }}
                                        </a>
                                    </h2>
                                    
                                    {# TAG dinámico según la entidad Estado Vital #}
                                    {% if jefe.estado %}
                                        {% set estado_lower = jefe.estado.nombre|lower %}
                                        <span class="badge rounded-pill px-2 py-1 text-uppercase fw-bold shadow-2xs" style="font-size: 0.65rem;
                                            {% if 'vivo' in estado_lower %} background-color: #198754; color: white;
                                            {% elseif 'muerto' in estado_lower or 'fallecido' in estado_lower %} background-color: #dc3545; color: white;
                                            {% else %} background-color: #6c757d; color: white; {% endif %}">
                                            {{ jefe.estado.nombre }}
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary rounded-pill text-uppercase fw-bold" style="font-size: 0.65rem;">?</span>
                                    {% endif %}
                                </div>

                                <div class="row g-2 text-secondary mb-3" style="font-size: 0.85rem;">
                                    <div class="col-6 col-sm-4">
                                        <span class="text-muted d-block small text-uppercase">Raza</span>
                                        <strong class="text-dark-emphasis">{{ jefe.raza ? jefe.raza.nombre : 'Desconocida' }}</strong>
                                    </div>
                                    <div class="col-6 col-sm-4">
                                        <span class="text-muted d-block small text-uppercase">Clase</span>
                                        <strong class="text-dark-emphasis">{{ jefe.clase ? jefe.clase.nombre : 'Sin Clase' }}</strong>
                                    </div>
                                </div>

                                <p class="text-muted small mb-0 text-truncate-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.35;">
                                    {{ jefe.descripcion ? jefe.descripcion : 'No hay informes recientes sobre los movimientos de este espécimen.' }}
                                </p>
                            </div>

                            <div class="text-end pt-2 border-top border-light-subtle mt-2">
                                <a href="{{ path('app_lobby_jefe_detalle', {'id': jefe.id}) }}" class="btn btn-sm btn-outline-dark text-uppercase fw-bold px-3" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                                    Ver Informe completo <i class="fa-solid fa-arrow-right ms-1 small"></i>
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <div class="text-muted opacity-50 mb-3">
                    <i class="fa-solid fa-scroll fa-3x"></i>
                </div>
                <h3 class="h5 fw-bold text-secondary text-uppercase">Códice Vacío</h3>
                <p class="text-muted small">No se han registrado amenazas de rango Élite en esta región todavía.</p>
            </div>
        {% endfor %}
    </div>

</div>

<style>
    .hover-shadow:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.08)!important;
        border-color: var(--bs-danger-border-subtle)!important;
    }
    .hover-danger:hover {
        color: #dc3545 !important;
    }
</style>
{% endblock %}